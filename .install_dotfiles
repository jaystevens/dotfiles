#!/bin/bash

#if [ $(uname) == "Darwin" ]; then
#    echo "macOS is not supported by the install_dotfiles script"
#    exit 1
#fi

if [ -e ~/.install_dotfiles ]; then
    echo "dotfiles already installed!"
    exit 1
fi

# grab home folder parent permissions
if [ ! -e ~/.install_dotfiles_perm ]; then
    ls -ailh ~/../ > ~/.install_dotfiles_perm
fi

# get home folder permissions
if [ $(uname) == "Darwin" ]; then
    # macOS
    HOME_FOLDER_PERM=`stat -f '%Lp' ~/`
else
    # linux / unix
    HOME_FOLDER_PERM=`stat -c '%a' ~/`
fi
if [ ! ${#HOME_FOLDER_PERM} -eq 3 ]; then
    echo "could not determine home folder permissions, exiting"
    exit 1
fi

# get script dir
DIR=$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )

# change to dotfiles folder
cd ${DIR}

# install dotfiles
cp -rp ./ ~/

# fix home folder permissions
chmod ${HOME_FOLDER_PERM} ~/

echo "installed dotfiles"
